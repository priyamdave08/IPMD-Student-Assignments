# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (matches docker-compose.yml demo DB)
PG_CONNECTION_STRING=postgres://ems:ems@localhost:5433/ems

# Gmail SMTP sender (use a Google app password, not the account password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
WARMUP_START_DATE=2026-01-01
SENDER_POSTAL_ADDRESS=

# Admin dashboard Basic Auth (bcrypt hash of the admin password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Signs open/click/unsubscribe tracking tokens (long random string)
JWT_SECRET=

# Public https URL of this service (tracking pixel, click + unsubscribe links).
# Must be reachable from the internet, not a private/VPN IP.
PUBLIC_BASE_URL=https://your-domain.com

# Landing page and campaign links
PUBLIC_APP_URL=
KICKSTARTER_URL=
VIP_KICKSTARTER_URL=
PRELAUNCH_URL=
COMMUNITY_URL=

# Shared secret with the Flask reservation backend
INTERNAL_SERVICE_TOKEN=

PORT=4000
