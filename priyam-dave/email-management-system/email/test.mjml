<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#2A2F42" padding="8px 0" />
    </mj-attributes>
    <mj-preview>Internal test — confirming the EchoSphere email system delivers.</mj-preview>
  </mj-head>
  <mj-body background-color="#F4F6FB">
    <mj-section padding="24px 0 8px 0">
      <mj-column>
        <mj-text align="center" font-size="20px" font-weight="bold" color="#7B4ED6">EchoSphere</mj-text>
        <mj-text align="center" font-size="12px" letter-spacing="1px" color="#9AA3B8">INTERNAL TEST EMAIL</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" border-radius="12px" padding="16px 24px">
      <mj-column>
        <mj-text>Hi {{first_name}},</mj-text>
        <mj-text>This is a <strong>test email</strong> from the IPMD Email Management System. If you're reading this, delivery, rendering, and tracking are all working end-to-end.</mj-text>
        <mj-text>Nothing to action here — you're on the internal test list. Please reply to confirm it landed in your inbox (and let us know if it went to spam).</mj-text>
        <mj-text>Thanks for helping us test 💜</mj-text>
        <mj-text>— The EchoSphere Team</mj-text>
        <mj-button href="{{RESERVE_LINK}}" background-color="#7B4ED6" color="#ffffff" font-size="16px" font-weight="bold" border-radius="8px" padding="24px 0 8px 0" inner-padding="14px 28px">Sample button (test link) →</mj-button>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
